import json
import os

def guardar_ofertas_tienda(nombre_tienda, nuevas_ofertas, archivo_datos='ofertas.json'):
    ofertas_actuales = []

    # 1. Leemos el archivo JSON actual si existe
    if os.path.exists(archivo_datos):
        try:
            with open(archivo_datos, 'r', encoding='utf-8') as f:
                ofertas_actuales = json.load(f)
        except Exception as e:
            print(f"Error leyendo {archivo_datos}: {e}")
            ofertas_actuales = []

    # 2. Filtramos manteniendo intactas las demás tiendas, 
    # y removiendo únicamente los registros viejos de la tienda que está corriendo actualizándose
    ofertas_otras_tiendas = [
        o for o in ofertas_actuales 
        if str(o.get('Almacen', o.get('tienda', ''))).strip().lower() != nombre_tienda.lower()
    ]

    # 3. Unimos los datos de las demás tiendas + las ofertas frescas y reales de esta ejecución
    total_ofertas = ofertas_otras_tiendas + nuevas_ofertas

    # 4. Guardamos el archivo consolidado y actualizado
    try:
        with open(archivo_datos, 'w', encoding='utf-8') as f:
            json.dump(total_ofertas, f, indent=2, ensure_ascii=False)
        print(f"Vitrina actualizada con éxito. Total ofertas guardadas: {len(total_ofertas)} ({nombre_tienda}: {len(nuevas_ofertas)})")
    except Exception as e:
        print(f"Error guardando {archivo_datos}: {e}")
